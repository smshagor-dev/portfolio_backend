APP_NAME="Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Existing MongoDB Atlas connection: copy from Atlas > Connect > Drivers.
# IMPORTANT: MONGODB_DATABASE must match the database used by the Node/Prisma backend.
# Keep credentials only in .env at repository root. Never commit the connection string.
DB_CONNECTION=mongodb
DATABASE_URL="mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=REPLACE_WITH_EXISTING_DATABASE_NAME

LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
# Preserve the old Express FTP upload contract; never save uploaded files locally.
FILESYSTEM_DISK=ftp_public
UPLOAD_STORAGE_DRIVER=ftp
UPLOAD_STORAGE_PUBLIC_BASE_URL=https://your-public-uploads-domain.example
UPLOAD_STORAGE_FTP_HOST=ftp.your-host.example
UPLOAD_STORAGE_FTP_PORT=21
UPLOAD_STORAGE_FTP_USER=
UPLOAD_STORAGE_FTP_PASSWORD=
UPLOAD_STORAGE_FTP_SECURE=true
UPLOAD_STORAGE_FTP_TLS_SERVERNAME=
UPLOAD_STORAGE_FTP_ALLOW_INVALID_CERT=false
UPLOAD_STORAGE_FTP_BASE_DIR=public_html
# Optional separate, NOT web-accessible location for private Job Agent files.
# Job Agent upload returns 503 until a genuinely private FTP root is configured.
UPLOAD_STORAGE_FTP_PRIVATE_BASE_DIR=

FRONTEND_URL=http://localhost:3000
# Explicit comma-separated HTTPS browser origins allowed by CORS.
# Example: CORS_ALLOWED_ORIGINS=https://smshagor.com,https://www.smshagor.com
CORS_ALLOWED_ORIGINS=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
ADMIN_TOKEN_EXPIRATION_MINUTES=10080

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Portfolio API"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

PORTFOLIO_AI_API_KEY=
# Migration-only: original Node AI_ENCRYPTION_KEY or ADMIN_JWT_SECRET.
# Do not rotate until all old AI provider keys have been re-encrypted.
AI_ENCRYPTION_KEY=
PORTFOLIO_AI_BASE_URL=https://api.openai.com/v1
PORTFOLIO_AI_MODEL=gpt-4o-mini

RESEARCH_SYNC_ENABLED=false
RESEARCH_ORCID_ID=
RESEARCH_AUTHOR_NAME=
RESEARCH_SYNC_INTERVAL_HOURS=12
OPENALEX_API_KEY=

JOB_AGENT_SEND_ENABLED=false
JOB_AGENT_ATTACHMENTS_ENABLED=false
JOB_AGENT_TRACKING_ENABLED=false
JOB_SOURCE_SYNC_ENABLED=false

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/admin/job-agent/gmail/callback

CONTACT_EMAIL_ENABLED=false
CONTACT_ADMIN_EMAIL=
