APP_NAME="Portfolio API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_TIMEZONE=UTC

# Existing MongoDB Atlas connection: copy from Atlas > Connect > Drivers.
# IMPORTANT: MONGODB_DATABASE must match the database used by the Node/Prisma backend.
# Keep credentials only in laravel/.env. Never commit the connection string.
DB_CONNECTION=mongodb
DATABASE_URL="mongodb+srv://USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DATABASE=REPLACE_WITH_EXISTING_DATABASE_NAME

LOG_CHANNEL=stack
LOG_LEVEL=debug
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:3000,127.0.0.1,127.0.0.1:3000
ADMIN_TOKEN_EXPIRATION_MINUTES=10080

MAIL_MAILER=log
MAIL_FROM_ADDRESS=noreply@example.test
MAIL_FROM_NAME="Portfolio API"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

PORTFOLIO_AI_API_KEY=
PORTFOLIO_AI_BASE_URL=https://api.openai.com/v1
PORTFOLIO_AI_MODEL=gpt-4o-mini

RESEARCH_SYNC_ENABLED=false
RESEARCH_ORCID_ID=
RESEARCH_AUTHOR_NAME=
RESEARCH_SYNC_INTERVAL_HOURS=12
OPENALEX_API_KEY=

JOB_AGENT_SEND_ENABLED=false
JOB_AGENT_ATTACHMENTS_ENABLED=false
JOB_AGENT_TRACKING_ENABLED=false
JOB_SOURCE_SYNC_ENABLED=false

GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8080/api/admin/job-agent/gmail/callback

CONTACT_EMAIL_ENABLED=false
CONTACT_ADMIN_EMAIL=
