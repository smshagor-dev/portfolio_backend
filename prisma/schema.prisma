generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Profile {
  id            Int      @id @map("_id")
  name          String
  profile       String
  designation   String
  description   String
  email         String
  phone         String
  address       String
  github        String
  facebook      String
  linkedIn      String
  twitter       String
  stackOverflow String
  leetcode      String
  socialLinks   Json     @default("[]")
  devUsername   String
  resume        String
  heroSkills    Json
  hardWorker    Boolean  @default(true)
  quickLearner  Boolean  @default(true)
  problemSolver Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Skill {
  id         Int      @id @map("_id")
  name       String   @unique
  image      String   @default("")
  percentage Int      @default(0)
  sortOrder  Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Experience {
  id          Int      @id @map("_id")
  title       String
  company     String
  location    String
  duration    String
  description String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Education {
  id          Int      @id @map("_id")
  title       String
  duration    String
  institution String
  department  String
  achievement String
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model StatsCounter {
  id        Int      @id @map("_id")
  label     String
  highlight String
  count     String
  icon      String
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Achievement {
  id        Int      @id @map("_id")
  title     String
  issuer    String
  date      String
  type      String
  image     String   @default("")
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ServiceSection {
  id        Int      @id @map("_id")
  title     String
  subtitle  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Service {
  id              Int              @id @map("_id")
  slug            String           @unique
  name            String
  impression      String
  impressionCount Int              @default(0)
  description     String
  content         String
  isFeatured      Boolean          @default(false)
  icon            String
  status          Boolean          @default(true)
  views           Int              @default(0)
  sortOrder       Int
  comments        ServiceComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ServiceComment {
  id         Int            @id @map("_id")
  serviceId  Int
  photo      String
  comment    String
  impression String
  sortOrder  Int
  service    Service        @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  replies    ServiceReply[]
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model ServiceReply {
  id         Int            @id @map("_id")
  commentId  Int
  reply      String
  impression String
  sortOrder  Int
  comment    ServiceComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
}

model Project {
  id              Int              @id @map("_id")
  slug            String           @unique
  name            String
  description     String
  content         String
  tools           Json
  role            String
  code            String
  demo            String
  image           String           @default("")
  views           Int              @default(0)
  impressionCount Int              @default(0)
  buttons         Json             @default("[]")
  sortOrder       Int
  comments        ProjectComment[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model ProjectComment {
  id        Int            @id @map("_id")
  projectId Int
  name      String
  comment   String
  sortOrder Int
  project   Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  replies   ProjectReply[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ProjectReply {
  id        Int            @id @map("_id")
  commentId Int
  name      String
  reply     String
  sortOrder Int
  comment   ProjectComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model Pricing {
  id          Int      @id @map("_id")
  slug        String   @unique
  name        String
  description String
  price       Float
  duration    String
  content     String
  features    Json
  status      Boolean  @default(true)
  isPopular   Boolean  @default(false)
  sortOrder   Int
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Faq {
  id        Int      @id @map("_id")
  question  String
  answer    String
  status    Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id        Int      @id @map("_id")
  name      String
  content   String
  image     String   @default("")
  company   String
  position  String   @default("")
  stars     Int      @default(5)
  status    Boolean  @default(true)
  sortOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Article {
  id               Int                         @id @map("_id")
  title            String
  slug             String                      @unique
  shortDescription String
  content          String
  category         String
  tags             Json                        @default("[]")
  featuredImage    String                      @default("")
  metaTitle        String                      @default("")
  metaDescription  String
  author           String
  status           String                      @default("draft")
  publishDate      DateTime?
  commentsEnabled  Boolean                     @default(true)
  isFeatured       Boolean                     @default(false)
  views            Int                         @default(0)
  impressionCount  Int                         @default(0)
  shareCount       Int                         @default(0)
  categories       ArticleCategoryAssignment[]
  comments         ArticleComment[]
  createdAt        DateTime                    @default(now())
  updatedAt        DateTime                    @updatedAt

  @@index([status, publishDate])
  @@index([category])
}

model ResearchPublication {
  id              Int               @id @map("_id")
  title           String
  slug            String            @unique
  shortSummary    String            @map("short_summary")
  content         String?
  publicationType String            @map("publication_type")
  researchArea    String            @map("research_area")
  publisherName   String            @map("publisher_name")
  publishedDate   DateTime          @map("published_date")
  doi             String?
  publicationUrl  String            @map("publication_url")
  citationUrl     String?           @map("citation_url")
  authors         Json?
  myAuthorRole    String?           @map("my_author_role")
  thumbnailImage  String?           @map("thumbnail_image")
  views           Int               @default(0)
  impressionCount Int               @default(0) @map("impression_count")
  shareCount      Int               @default(0) @map("share_count")
  comments        ResearchComment[]
  isFeatured      Boolean           @default(false) @map("is_featured")
  status          String            @default("published")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  @@index([publicationType], map: "research_publications_publication_type_idx")
  @@index([researchArea], map: "research_publications_research_area_idx")
  @@index([status], map: "research_publications_status_idx")
  @@index([isFeatured], map: "research_publications_is_featured_idx")
  @@index([publishedDate], map: "research_publications_published_date_idx")
  @@map("research_publications")
}

model ResearchComment {
  id            Int                 @id @map("_id")
  publicationId Int                 @map("publication_id")
  name          String
  comment       String
  sortOrder     Int                 @map("sort_order")
  publication   ResearchPublication @relation(fields: [publicationId], references: [id], onDelete: Cascade)
  replies       ResearchReply[]
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([publicationId], map: "researchcomment_publication_id_idx")
  @@map("researchcomment")
}

model ResearchReply {
  id        Int             @id @map("_id")
  commentId Int             @map("comment_id")
  name      String
  reply     String
  sortOrder Int             @map("sort_order")
  comment   ResearchComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([commentId], map: "researchreply_comment_id_idx")
  @@map("researchreply")
}

model ArticleComment {
  id        Int            @id @map("_id")
  articleId Int
  name      String
  comment   String
  sortOrder Int
  article   Article        @relation(fields: [articleId], references: [id], onDelete: Cascade)
  replies   ArticleReply[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ArticleReply {
  id        Int            @id @map("_id")
  commentId Int
  name      String
  reply     String
  sortOrder Int
  comment   ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model ArticleCategory {
  id        Int                         @id @map("_id")
  name      String                      @unique
  slug      String                      @unique
  articles  ArticleCategoryAssignment[]
  createdAt DateTime                    @default(now())
  updatedAt DateTime                    @updatedAt
}

model ArticleCategoryAssignment {
  id         String          @id @default(auto()) @map("_id") @db.ObjectId
  articleId  Int
  categoryId Int
  article    Article         @relation(fields: [articleId], references: [id], onDelete: Cascade)
  category   ArticleCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([articleId, categoryId])
  @@index([categoryId])
}

model ContactMessage {
  id           Int                  @id @map("_id")
  name         String
  email        String
  subject      String               @default("")
  message      String
  photo        String               @default("")
  file         String               @default("")
  status       String               @default("not_solved")
  ticketToken  String               @unique
  createdAt    DateTime             @default(now())
  chatMessages ContactChatMessage[]
}

model ContactChatMessage {
  id               Int            @id @map("_id")
  contactMessageId Int
  senderType       String
  senderName       String         @default("")
  message          String
  photo            String         @default("")
  file             String         @default("")
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)

  @@index([contactMessageId, createdAt])
}

enum AdminNotificationType {
  NEW_MESSAGE
  MESSAGE_REPLY
}

model AdminNotification {
  id             String                @id @default(cuid()) @map("_id")
  type           AdminNotificationType
  title          String
  body           String?
  visitorName    String?
  visitorEmail   String?
  visitorPhone   String?
  messageId      Int?
  conversationId Int?
  preview        String?
  actionUrl      String?
  isRead         Boolean               @default(false)
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([isRead, createdAt])
  @@index([messageId, conversationId])
}

model EmergencyContact {
  id        Int      @id @map("_id")
  label     String
  name      String
  icon      String
  link      String
  sortOrder Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("emergencycontact")
}

model AdminUser {
  id               Int      @id @map("_id")
  name             String
  email            String   @unique
  passwordHash     String
  twoFactorSecret  String?
  twoFactorEnabled Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AiProvider {
  id        Int      @id @map("_id")
  name      String   @unique
  apiKey    String   @map("api_key")
  baseUrl   String   @default("") @map("base_url")
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_providers")
}

model AiSettings {
  id             Int      @id @map("_id")
  activeProvider String   @map("active_provider")
  modelName      String   @map("model_name")
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("ai_settings")
}

model AiTrainingEntry {
  id        Int      @id @map("_id")
  question  String
  answer    String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("ai_training_entries")
}

model SiteSettings {
  id                         Int      @id @map("_id")
  websiteTitle               String
  websiteDescription         String
  navTitle                   String
  navSubtitle                String
  seoTitle                   String
  seoDescription             String
  seoKeywords                String
  seoImage                   String
  websiteIcon                String
  heroHeaderText             String
  heroDescription            String
  heroImage                  String
  contactEmail               String
  mobileNumber               String
  footerText                 String
  privacyPolicyHtml          String
  termsConditionsHtml        String
  canonicalUrl               String
  googleSiteVerification     String
  googleVerificationFilePath String
  googleAnalyticsId          String
  googleTagManagerId         String
  adsenseHeadCode            String
  adsensePageTopCode         String
  adsenseBetweenSectionsCode String
  adsensePageBottomCode      String
  robotsIndexingEnabled      Boolean  @default(true)
  robotsFollowEnabled        Boolean  @default(true)
  smtpHost                   String
  smtpPort                   Int      @default(587)
  smtpUser                   String
  smtpPass                   String
  smtpSecure                 Boolean  @default(false)
  smtpFromEmail              String
  smtpFromName               String
  smtpReplyToEmail           String
  smtpToEmail                String
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
}

model AnalyticsSession {
  id         Int                   @id @map("_id")
  sessionId  String                @unique
  firstPath  String                @default("/")
  lastPath   String                @default("/")
  ipAddress  String                @default("")
  country    String                @default("")
  region     String                @default("")
  city       String                @default("")
  userAgent  String?
  createdAt  DateTime              @default(now())
  lastSeenAt DateTime              @default(now())
  dailyVisits AnalyticsDailyVisit[]
  pageViews   AnalyticsPageView[]
}

model AnalyticsDailyVisit {
  id         Int              @id @map("_id")
  sessionRef Int
  visitDate  DateTime
  path       String           @default("/")
  createdAt  DateTime         @default(now())
  session    AnalyticsSession @relation(fields: [sessionRef], references: [id], onDelete: Cascade)

  @@unique([sessionRef, visitDate])
  @@index([visitDate])
}

model AnalyticsPageView {
  id            Int              @id @map("_id")
  sessionRef    Int
  path          String           @default("/")
  firstViewedAt DateTime         @default(now())
  lastViewedAt  DateTime         @default(now())
  viewCount     Int              @default(1)
  session       AnalyticsSession @relation(fields: [sessionRef], references: [id], onDelete: Cascade)

  @@unique([sessionRef, path])
  @@index([lastViewedAt])
}

model CvProfile {
  id                 Int        @id @map("_id")
  title              String     @default("Optional CV Notes")
  extraNotes         String
  targetRoles        Json       @default("[]")
  preferredCountries Json       @default("[]")
  resumeUrl          String     @default("")
  resumeFileName     String     @default("")
  resumeUpdatedAt    DateTime?
  isDefault          Boolean    @default(true)
  jobMatches         JobMatch[]
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  @@map("cv_profiles")
}

model JobSource {
  id           Int       @id @map("_id")
  name         String
  type         String
  provider     String
  status       String    @default("active")
  config       Json      @default("{}")
  lastSyncedAt DateTime?
  jobPosts     JobPost[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([type, provider])
  @@map("job_sources")
}

model JobPost {
  id                     Int                @id @map("_id")
  sourceId               Int?
  source                 JobSource?         @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  sourceType             String
  externalId             String?
  sourceEmail            String             @default("")
  sourceSubject          String             @default("")
  sourcePlatform         String             @default("")
  emailSubject           String             @default("")
  title                  String
  company                String
  location               String             @default("")
  sourceUrl              String
  applyUrl               String
  companyUrl             String
  extractedUrls          Json               @default("[]")
  jobType                String             @default("")
  workMode               String             @default("")
  region                 String             @default("")
  experienceLevel        String             @default("")
  sourceName             String             @default("")
  importMethod           String             @default("")
  descriptionStatus      String             @default("READY")
  searchKeywordMatched   String             @default("")
  description            String
  rawContent             String
  recruiterContacts      RecruiterContact[]
  matches                JobMatch[]
  emailDrafts            JobEmailDraft[]
  status                 String             @default("new")
  contactDiscoveryStatus String             @default("pending")
  contactDiscoveryError  String             @default("")
  lastContactDiscoveryAt DateTime?
  receivedAt             DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  @@index([sourceType, externalId])
  @@index([status, createdAt])
  @@index([company])
  @@index([descriptionStatus])
  @@index([importMethod])
  @@map("job_posts")
}

model JobSearchPreference {
  id                       Int      @id @map("_id")
  rolesJson                Json     @default("[]")
  customKeywordsJson       Json     @default("[]")
  jobTypesJson             Json     @default("[]")
  workModesJson            Json     @default("[]")
  regionsJson              Json     @default("[]")
  experienceLevelsJson     Json     @default("[]")
  preferredLanguagesJson   Json     @default("[]")
  maxJobsPerSync           Int      @default(25)
  minimumMatchScoreToDraft Int      @default(60)
  autoDraftEnabled         Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  @@map("job_search_preferences")
}

model JobBoardSource {
  id                Int                  @id @map("_id")
  sourceName        String
  companyName       String               @default("")
  region            String
  sourceType        String
  baseUrl           String
  careersUrl        String
  detectedProvider  String               @default("")
  extractionStatus  String               @default("UNSUPPORTED")
  extractionMessage String
  selectorConfigJson Json?
  lastImportStatsJson Json?
  enabled           Boolean              @default(false)
  notes             String               @default("")
  requiresApiKey    Boolean              @default(false)
  apiKeyEncrypted   String?
  lastSyncAt        DateTime?
  status            String               @default("Planned")
  importRuns        JobSourceImportRun[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@unique([sourceName, region])
  @@index([enabled, sourceType])
  @@map("job_board_sources")
}

model JobSourceImportRun {
  id                    Int            @id @map("_id")
  sourceId              Int
  source                JobBoardSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  status                String
  startedAt             DateTime
  finishedAt            DateTime?
  importedCount         Int            @default(0)
  duplicateCount        Int            @default(0)
  needsDescriptionCount Int            @default(0)
  errorMessage          String         @default("")
  createdAt             DateTime       @default(now())

  @@index([sourceId, createdAt])
  @@map("job_source_import_runs")
}

model JobMatch {
  id            Int        @id @map("_id")
  jobPostId     Int
  jobPost       JobPost    @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  cvProfileId   Int?
  cvProfile     CvProfile? @relation(fields: [cvProfileId], references: [id], onDelete: SetNull)
  score         Int
  matchedSkills Json       @default("[]")
  missingSkills Json       @default("[]")
  summary       String
  aiAnalysis    Json       @default("{}")
  coverLetter   String
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([jobPostId, cvProfileId])
  @@index([score])
  @@map("job_matches")
}

model RecruiterContact {
  id                 Int             @id @map("_id")
  jobPostId          Int?
  jobPost            JobPost?        @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  emailDrafts        JobEmailDraft[]
  name               String          @default("")
  email              String
  companyName        String          @default("")
  companyDomain      String          @default("")
  source             String
  sourceUrl          String
  discoveryMethod    String          @default("")
  validationStatus   String          @default("pending")
  contactEmailStatus String          @default("pending")
  confidenceScore    Int             @default(0)
  isRecruiter        Boolean         @default(false)
  isHiringManager    Boolean         @default(false)
  evidence           Json            @default("{}")
  lastVerifiedAt     DateTime?
  errorMessage       String          @default("")
  verification       String          @default("manual")
  verified           Boolean         @default(false)
  publicContext      String          @default("")
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([email])
  @@map("recruiter_contacts")
}

model JobEmailDraft {
  id                   Int               @id @map("_id")
  jobPostId            Int
  jobPost              JobPost           @relation(fields: [jobPostId], references: [id], onDelete: Cascade)
  recruiterContactId   Int?
  recruiterContact     RecruiterContact? @relation(fields: [recruiterContactId], references: [id], onDelete: SetNull)
  toEmail              String            @default("")
  subject              String
  body                 String
  trackingId           String            @unique @default(cuid())
  aiProvider           String            @default("")
  aiModel              String            @default("")
  emailPromptUsed      String            @default("")
  coverLetterPromptUsed String           @default("")
  coverLetterText      String            @default("")
  coverLetterPdfUrl    String            @default("")
  cvUrl                String            @default("")
  adminApprovalRequired Boolean          @default(true)
  approvalStatus       String            @default("PENDING")
  status               String            @default("DRAFT")
  approvedAt           DateTime?
  approvedBy           String            @default("")
  rejectedAt           DateTime?
  rejectionReason      String            @default("")
  sentAt               DateTime?
  openedAt             DateTime?
  lastOpenedAt         DateTime?
  openCount            Int               @default(0)
  clickedAt            DateTime?
  clickCount           Int               @default(0)
  providerMessageId    String            @default("")
  sendStatus           String            @default("pending")
  skipReason           String            @default("")
  errorMessage         String            @default("")
  lastSendAttemptAt    DateTime?
  events               JobAgentEmailEvent[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([sentAt])
  @@map("job_email_drafts")
}

model JobAgentSettings {
  id                  Int      @id @map("_id")
  gmailConnectedEmail String   @default("")
  gmailRefreshToken   String   @default("")
  gmailHistoryId      String   @default("")
  gmailQuery          String   @default("(from:linkedin OR from:indeed OR subject:(job alert) OR subject:(jobs for you)) newer_than:30d")
  dailySendLimit      Int      @default(5)
  sendsToday          Int      @default(0)
  sendLimitDate       DateTime?
  autoSendEnabled     Boolean  @default(false)
  defaultCvProfileId  Int?
  approvedApiSources  Json     @default("[]")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("job_agent_settings")
}

model JobAgentEmailSetting {
  id                    Int      @id @map("_id")
  adminId               Int?
  fromName              String   @default("")
  fromEmail             String   @default("")
  smtpHost              String   @default("smtp.gmail.com")
  smtpPort              Int      @default(465)
  smtpSecure            Boolean  @default(true)
  smtpUsername          String   @default("")
  smtpPasswordEncrypted String   @default("")
  dailySendLimit        Int      @default(5)
  isEnabled             Boolean  @default(false)
  openTrackingEnabled   Boolean  @default(false)
  clickTrackingEnabled  Boolean  @default(false)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("job_agent_email_settings")
}

model JobAgentEmailEvent {
  id             Int           @id @map("_id")
  draftId        Int
  draft          JobEmailDraft @relation(fields: [draftId], references: [id], onDelete: Cascade)
  jobPostId      Int
  recipientEmail String
  eventType      String
  trackingId     String
  url            String
  userAgent      String
  ipHash         String        @default("")
  createdAt      DateTime      @default(now())

  @@index([draftId, eventType, createdAt])
  @@index([trackingId])
  @@index([jobPostId])
  @@map("job_agent_email_events")
}

model JobAgentAiSetting {
  id                      Int      @id @map("_id")
  aiProvider              String   @default("DEEPSEEK")
  aiModel                 String   @default("deepseek-chat")
  deepseekApiKeyEncrypted String?
  geminiApiKeyEncrypted   String?
  openaiApiKeyEncrypted   String?
  fallbackProvider        String?
  fallbackEnabled         Boolean  @default(false)
  systemPrompt            String
  recruiterEmailPrompt    String
  coverLetterPrompt       String
  tone                    String   @default("professional-natural")
